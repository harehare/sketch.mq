# Probabilistic summaries of a stream of items that use a fixed amount of memory:
#
# - `hll`: HyperLogLog, which estimates how many distinct items it has seen
# - `cms`: Count-Min Sketch, which estimates how many times each item has been seen
#
# Items are compared by the string `to_string` gives for them. Both sketches are plain arrays, and
# every operation returns the updated sketch.

module hll:
  # Reads a hexadecimal string as a number.
  def _hex_to_number(hex): fold(explode(hex), 0, fn(acc, cp): acc * 16 + (if (cp < 58): cp - 48 else: cp - 87););

  # Returns the number of bits in a whole number, 0 for 0.
  def _bit_length(x):
    var n = 0
    | var v = x
    | let _ = while (v >= 1):
        v = floor(v / 2)
        | n = n + 1
      end
    | n
  end

  # The number of hash bits used: the first `precision` pick a register and the rest are ranked.
  def _hash_bits(): 48;

  # Returns an empty counter with 2^precision registers, for a precision from 4 to 16. A higher
  # precision is more accurate and takes more memory.
  def new(precision):
    if (precision < 4 || precision > 16 || precision != floor(precision)):
      error("hll: precision must be a whole number from 4 to 16")
    else:
      [precision] + map(range(1, pow(2, precision)), fn(i): 0;)
  end

  # Returns the precision.
  def precision(h): h[0];

  # Returns the standard error to expect: about 1.04 / sqrt(registers).
  def error_rate(h): 1.04 / sqrt(pow(2, h[0]));

  # Adds an item.
  def add(h, item):
    var a = h
    | let p = a[0]
    | let tail_bits = 48 - p
    | let hash = _hex_to_number(sha256(to_string(item))[0:12])
    | let register = 1 + floor(hash / pow(2, tail_bits))
    | let rank = tail_bits - _bit_length(hash % pow(2, tail_bits)) + 1
    | let _ = if (rank > a[register]): a[register] = rank else: None
    | a
  end

  # Adds every item of an array.
  def add_all(h, items):
    var a = h
    | var i = 0
    | let _ = while (i < len(items)):
        a = add(a, items[i])
        | i = i + 1
      end
    | a
  end

  # Returns the estimated number of distinct items added.
  def count(h):
    let m = pow(2, h[0])
    | let alpha = if (m == 16): 0.673 elif (m == 32): 0.697 elif (m == 64): 0.709 else: 0.7213 / (1 + 1.079 / m)
    | var total = 0
    | var zeros = 0
    | var i = 1
    | let _ = while (i <= m):
        total = total + pow(2, -h[i])
        | zeros = zeros + if (h[i] == 0): 1 else: 0
        | i = i + 1
      end
    | let estimate = alpha * m * m / total
    | round(if (estimate <= 2.5 * m && zeros > 0): m * ln(m / zeros) else: estimate)
  end

  # Returns a counter for the items of both, which must have the same precision.
  def merge(a, b):
    if (a[0] != b[0]):
      error("hll: counters differ in precision")
    else:
      do
        var out = a
        | var i = 1
        | let _ = while (i < len(a)):
            let _ = if (b[i] > out[i]): out[i] = b[i] else: None
            | i = i + 1
          end
        | out
      end
  end
end

module cms:
  # Reads a hexadecimal string as a number.
  def _hex_to_number(hex): fold(explode(hex), 0, fn(acc, cp): acc * 16 + (if (cp < 58): cp - 48 else: cp - 87););

  # The two base hashes of an item, the second one odd.
  def _base_hashes(item):
    let digest = sha256(to_string(item))
    | let h2 = _hex_to_number(digest[8:16])
    | [_hex_to_number(digest[0:8]), h2 + 1 - h2 % 2]
  end

  # Returns an empty sketch of `depth` rows of `width` counters. Counts are overestimated by about
  # total / width, with a chance of exceeding that of about e^-depth.
  def new(width, depth):
    if (width < 1 || depth < 1):
      error("cms: width and depth must be at least 1")
    else:
      [width, depth, 0] + map(range(1, width * depth), fn(i): 0;)
  end

  # Returns an empty sketch whose estimates exceed the true count by at most `epsilon` times the total
  # added, with probability at least `1 - delta`.
  def for_error(epsilon, delta):
    if (epsilon <= 0 || epsilon >= 1 || delta <= 0 || delta >= 1):
      error("cms: epsilon and delta must be between 0 and 1")
    else:
      new(ceil(exp(1) / epsilon), ceil(ln(1 / delta)))
  end

  # Returns the number of counts added.
  def total(s): s[2];

  # Adds `amount` occurrences of an item.
  def add_many(s, item, amount):
    if (amount < 0):
      error("cms: the amount must not be negative")
    else:
      do
        var a = s
        | let width = a[0]
        | let h = _base_hashes(item)
        | var r = 0
        | let _ = while (r < a[1]):
            let index = 3 + r * width + (h[0] + r * h[1]) % width
            | a[index] = a[index] + amount
            | r = r + 1
          end
        | a[2] = a[2] + amount
        | a
      end
  end

  # Adds one occurrence of an item.
  def add(s, item): add_many(s, item, 1);

  # Adds every item of an array.
  def add_all(s, items):
    var a = s
    | var i = 0
    | let _ = while (i < len(items)):
        a = add_many(a, items[i], 1)
        | i = i + 1
      end
    | a
  end

  # Returns the estimated count of an item, which is never below the true count.
  def estimate(s, item):
    let width = s[0]
    | let h = _base_hashes(item)
    | var best = s[2]
    | var r = 0
    | let _ = while (r < s[1]):
        let value = s[3 + r * width + (h[0] + r * h[1]) % width]
        | best = if (value < best): value else: best
        | r = r + 1
      end
    | best
  end

  # Returns a sketch for the counts of both, which must have the same width and depth.
  def merge(a, b):
    if (a[0] != b[0] || a[1] != b[1]):
      error("cms: sketches differ in width or depth")
    else:
      do
        var out = a
        | var i = 2
        | let _ = while (i < len(a)):
            out[i] = a[i] + b[i]
            | i = i + 1
          end
        | out
      end
  end
end
